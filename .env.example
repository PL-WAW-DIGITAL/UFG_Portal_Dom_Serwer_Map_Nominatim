# Geofabrik Poland extract
PBF_URL=https://download.geofabrik.de/europe/poland-latest.osm.pbf
REPLICATION_URL=https://download.geofabrik.de/europe/poland-updates/

# Nominatim — tylko miejscowosci + ulice (bez POI)
NOMINATIM_PASSWORD=changeme
NOMINATIM_PORT=8080
# Filtrowany PBF z filter-pbf.ps1 (place + highway + admin boundaries)
NOMINATIM_PBF_PATH=/data/pbf/poland-filtered.osm.pbf
IMPORT_STYLE=street
# street  = miejscowosci + ulice (zalecane, bez POI/adresow punktowych)
# address = j.w. + numery domow
# admin   = tylko obszary administracyjne
# full    = pelny import (nie uzywac)

# PostgreSQL tuning (dostosuj do RAM serwera)
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_MAINTENANCE_WORK_MEM=4GB
POSTGRES_EFFECTIVE_CACHE_SIZE=8GB

# Tiles (uzywaja peonego poland-latest.osm.pbf)
TILE_FORMAT=pmtiles
MARTIN_PORT=3000
NGINX_CACHE_PORT=8081
PLANETILER_MEMORY=8g

# Sciezki danych (wzgledem katalogu projektu)
DATA_DIR=./data
PBF_DIR=./data/pbf
TILES_DIR=./data/tiles
