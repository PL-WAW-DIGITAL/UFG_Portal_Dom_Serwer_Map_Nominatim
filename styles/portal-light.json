{
  "version": 8,
  "name": "Portal DOM Light",
  "metadata": {
    "description": "Jasny styl mapy Portal DOM — lokalne kafelki OpenMapTiles",
    "portal-dom": {
      "variant": "light",
      "tileServer": "local-martin"
    }
  },
  "sources": {
    "poland": {
      "type": "vector",
      "url": "http://localhost:8081/poland.json",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "sprite": "https://demotiles.maplibre.org/styles/osm-bright/sprite",
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f8f4f0" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "poland",
      "source-layer": "water",
      "paint": { "fill-color": "#aad3df" }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "poland",
      "source-layer": "landuse",
      "filter": ["==", ["get", "class"], "residential"],
      "paint": { "fill-color": "#e8e4e0", "fill-opacity": 0.5 }
    },
    {
      "id": "landuse-green",
      "type": "fill",
      "source": "poland",
      "source-layer": "landuse",
      "filter": ["in", ["get", "class"], ["literal", ["park", "grass", "forest", "meadow"]]],
      "paint": { "fill-color": "#c8e6c9", "fill-opacity": 0.6 }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "poland",
      "source-layer": "park",
      "paint": { "fill-color": "#d4edda", "fill-opacity": 0.7 }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "poland",
      "source-layer": "building",
      "minzoom": 13,
      "paint": { "fill-color": "#d9d0c9", "fill-opacity": 0.7 }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "poland",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["minor", "service", "track"]]],
      "paint": { "line-color": "#ffffff", "line-width": 1 }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "poland",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["secondary", "tertiary"]]],
      "paint": { "line-color": "#ffffff", "line-width": 2 }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "poland",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["primary", "trunk"]]],
      "paint": { "line-color": "#fde68a", "line-width": 3 }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "poland",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "motorway"],
      "paint": { "line-color": "#fca5a5", "line-width": 4 }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "poland",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Open Sans Regular"],
        "text-size": 11,
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#555555",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "poland",
      "source-layer": "boundary",
      "filter": ["==", ["get", "admin_level"], 4],
      "paint": {
        "line-color": "#9ca3af",
        "line-width": 1,
        "line-dasharray": [4, 2]
      }
    }
  ]
}
